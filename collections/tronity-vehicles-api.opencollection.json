{
  "opencollection": "1.0.0",
  "info": {
    "name": "TRONITY Platform Authentication Vehicles API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Vehicles",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve many Vehicle",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tronity.tech/v1/vehicles",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Lists the vehicles available to the authenticated app or fleet."
        },
        {
          "info": {
            "name": "Retrieve one Vehicle",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tronity.tech/v1/vehicles/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The vehicle identifier."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve one Vehicle"
        },
        {
          "info": {
            "name": "Delete one Vehicle",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.tronity.tech/v1/vehicles/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The vehicle identifier."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete one Vehicle"
        },
        {
          "info": {
            "name": "Get vin from the vehicle",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tronity.tech/v1/vehicles/:vehicleId/vin",
            "params": [
              {
                "name": "vehicleId",
                "value": "",
                "type": "path",
                "description": "The vehicle identifier."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get vin from the vehicle"
        }
      ]
    }
  ],
  "bundled": true
}